# ICP skills — auto-synced by the SessionStart hook (.agents/sync-ic-skills.sh,
# reached as .claude/sync-ic-skills.sh through the committed .claude -> .agents
# symlink). The hook and script are committed; the skills they fetch are not.
.agents/skills/
# Local Claude Code settings (personal; the shared hook lives in .agents/settings.json)
.agents/settings.local.json

.mops
.migrations-*/

# build artifacts (commit .icp/data/ when it appears — it holds canister ID mappings)
.icp/cache/
# reproducible-build output (scripts/reproducible-build.sh) — hashes are
# published in release notes, binaries are rebuildable from the tag
release/
# dist is build output, but backend.did stays committed (spec §8 "committed
# .did") — every `mops build` refreshes it, so the committed interface can
# never silently drift, and the frontend's bindgen reads it from disk.
src/backend/dist/*
!src/backend/dist/backend.did

# a stray root-level node_modules appears if anyone runs npx/vitest from the
# repo root instead of the workspace that owns the tooling
/node_modules/

# frontend (src/frontend)
src/frontend/node_modules/
src/frontend/dist/
# the fixtures build the browser specs serve (npm run build:fixtures). A separate
# outDir on purpose: `dist/` is what ships, and a bundle carrying the test hook
# must never be reachable by a deploy.
src/frontend/dist-fixtures/
src/frontend/src/bindings/

# Playwright's per-run failure artifacts (traces, diff images). The screenshot
# BASELINES beside them are committed on purpose — see test/browser/visual.spec.ts.
test/browser/test-results/
test/browser/playwright-report/

# PocketIC integration suite (test/integration)
test/integration/node_modules/
# fetched by scripts/fetch-ledger-wasm.mjs, sha256-pinned there — the pin is
# committed, the binary is not
test/integration/wasm/
