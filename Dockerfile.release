# Reproducible release build (spec §8).
#
# The toolchain is DFINITY's published dev-env image, pinned by digest, so the versions
# of `icp`, `ic-wasm`, `mops` and `node` come from one artifact instead of from four npm
# pins this repo would have to maintain. `moc` and the Motoko dependencies still come
# from the committed `mops.toml [toolchain]` and `mops.lock` — the repo is the authority
# for those, and this file deliberately does not restate their versions.
#
# ⚠️ **Pinned by digest, not by tag.** A tag can move; the module hash must not. The
# digest below is the multi-arch index for `v2.1.0`, so `--platform` still selects the
# right child image.
#
# ⚠️ **Changing this image changes every module hash.** That is correct behaviour — the
# image is part of what shapes the bytes — but it means a bump belongs in its own release
# with its own published hashes, never alongside unrelated changes.
#
# NOT pinned, stated so the claim above is not read wider than it is: whatever the image
# resolves at build time from the network (mops fetches `moc` and the Motoko packages).
# Same ref against the same image digest reproduces; across a registry change it is not
# guaranteed.
#
# Build context must be a clean git tree — use scripts/release.sh or
# scripts/reproducible-build.sh, which pipe `git archive <ref>` in, so local uncommitted
# state can never leak into a published hash.

FROM ghcr.io/dfinity/icp-dev-env-motoko:v2.1.0@sha256:02780158214ff3d0aeadf3ad364fc67025827765410e7538de7d770742eaf7a2 AS build

# ⚠️ The image installs its toolchain under nvm and exports PATH in its own Env, which a
# non-login `RUN` does not pick up. Setting it here is what makes `icp` resolvable.
ENV PATH=/root/.nvm/versions/node/v24.20.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /build
COPY . .
RUN bash scripts/release-build.sh /artifacts

# Final stage holds only the release artifacts, so
# `docker build --output type=local,dest=release` writes exactly them.
FROM scratch
COPY --from=build /artifacts /
