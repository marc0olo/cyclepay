# Reproducible release build (spec §8). Every byte-shaping tool is pinned:
#  - base image by digest (node 22.22.1 — also the frontend build's node)
#  - ic-mops / icp-cli / ic-wasm by exact npm version
#  - moc 1.9.0 via the committed mops.toml [toolchain]
#  - Motoko deps via the committed mops.lock
#  - recipes by tag in the committed icp.yaml (icp-cli rejects unpinned)
#
# Build context must be a clean git tree — use scripts/reproducible-build.sh,
# which pipes `git archive <ref>` in, so local uncommitted state can never
# leak into a published hash.
#
#   git archive --format=tar <ref> | \
#     docker build -f Dockerfile.release --output type=local,dest=release -

FROM node:22.22.1-bookworm-slim@sha256:4f77a690f2f8946ab16fe1e791a3ac0667ae1c3575c3e4d0d4589e9ed5bfaf3d AS build

RUN apt-get update \
 && apt-get install -y --no-install-recommends libdbus-1-3 ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g ic-mops@2.13.2 @icp-sdk/icp-cli@0.3.2 @icp-sdk/ic-wasm@0.9.11

WORKDIR /build
COPY . .
RUN bash scripts/release-build.sh /artifacts

# Final stage holds only the release artifacts, so
# `docker build --output type=local,dest=release` writes exactly them.
FROM scratch
COPY --from=build /artifacts /
