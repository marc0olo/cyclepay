{
  "name": "cyclepay-integration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PocketIC integration suite \u2014 the Card rail go-live bar (spec \u00a79).",
  "scripts": {
    "build:backend": "cd ../.. && mops build",
    "fetch:wasm": "node scripts/fetch-wasms.mjs",
    "pretest": "npm run fetch:wasm && npm run build:backend",
    "test": "vitest run",
    "presandbox": "npm run fetch:wasm && npm run build:backend",
    "sandbox": "npx tsx src/sandbox.ts",
    "typecheck": "tsc --noEmit",
    "bindings": "icp-bindgen --did-file ../../src/backend/dist/backend.did --out-dir src/generated --actor-disabled --force"
  },
  "devDependencies": {
    "@dfinity/pic": "^0.23.0",
    "@icp-sdk/bindgen": "^0.4.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "@dfinity/pic@0.23.0": true
  }
}
