[
  {
    // Defaults for every asset: certified-only serving (raw domain allows
    // undetected tampering by boundary nodes — the verifiability thesis says
    // never serve uncertified), standard security headers, revalidate HTML.
    "match": "**/*",
    "security_policy": "standard",
    "headers": {
      "Cache-Control": "public, max-age=0, must-revalidate"
    },
    "allow_raw_access": false
  },
  {
    // Vite content-hashes everything under assets/ — cache forever.
    "match": "assets/**/*",
    "headers": {
      "Cache-Control": "public, max-age=31536000, immutable"
    }
  },
  {
    // SPA fallback: unmatched paths serve index.html instead of 404.
    "match": "**/*",
    "enable_aliasing": true
  }
]
