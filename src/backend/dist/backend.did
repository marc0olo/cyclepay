type ValidateError = 
 variant {
   aboveCeiling: record {
                   id: text;
                   maxUsdCents: nat;
                   usdCents: nat;
                 };
   belowFloor: record {
                 id: text;
                 minUsdCents: nat;
                 usdCents: nat;
               };
   duplicateTierId: text;
   emptyTierId;
   zeroUsdCents: text;
 };
