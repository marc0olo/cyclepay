 record {
   feeBps: nat;
   feeFixedCents: nat;
   rateQueriedSources: nat;
   rateReceivedRates: nat;
   rateStandardDeviation: nat;
   ratesFetchedAtNs: int;
   usdCents: nat;
   usdPerIcpMicros: nat;
   xdrPermyriadPerIcp: nat;
 };
type Page = 
 record {
   entries: vec Entry;
   nextCursor: opt nat;
 };
type Owner = variant {ii: principal;};
type OriginError = 
 variant {
   "empty";
   hasQueryOrFragment;
   notHttps;
 };
type OrderStatus = 
 variant {
   abandoned;
   cancelled;
   created;
   delivered;
   expired;
   needsReview;
   paid;
 };
type OrderId = text;
type Order = 
 record {
   createdAtNs: int;
   destination: Destination;
   expiredBy: opt ExpiredBy;
   expiresAtNs: opt int;
   id: OrderId;
   lockedCycles: nat;
   owner: Owner;
   paidUsdCents: opt nat;
   pricing: Pricing;
   rail: Rail;
   status: OrderStatus;
   stripeSessionId: opt text;
   stripeSessionUrl: opt text;
   updatedAtNs: int;
 };
type Kind = 
 variant {
   abandoned: record {
                orderId: OrderId;
                reason: text;
              };
   deliveryDelayed: record {
                      orderId: OrderId;
                      sinceNs: int;
                      stage: text;
                    };
   deliveryStuck: record {
                    blockIndex: opt nat;
                    orderId: OrderId;
                    stage: text;
                  };
   duplicate: record {
                orderId: OrderId;
                paymentRef: text;
              };
   refundAfterDelivery:
    record {
      cycles: nat;
      fullRefund: bool;
      orderId: OrderId;
      paymentRef: text;
      refundedCents: nat;
    };
   unattributed: record {
                   claimedRef: text;
                   paymentRef: text;
                 };
   undeliverable: record {
                    cycles: nat;
                    orderId: OrderId;
                  };
   unprocessable: record {
                    eventId: text;
                    field: text;
                  };
 };
type JournalEntry = 
 record {
   blockIndex: opt nat;
   createdAtNs: int;
   cyclesMinted: opt nat;
   destination: Destination;
   orderId: OrderId;
   retries: nat;
   status: OrderStatus;
   transferIntent: opt TransferIntent;
   updatedAtNs: int;
 };
