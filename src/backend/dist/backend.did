   generation: nat;
   isSet: bool;
   setAtNs: opt int;
 };
type SetError = variant {tooShort: record {
                                     min: nat;
                                     size: nat;
                                   };};
type Result_9 = 
 variant {
   err: text;
   ok: Order;
 };
type Result_8 = 
 variant {
   err: ResolveError;
   ok: Entry;
 };
type Result_7 = 
 variant {
   err: text;
   ok: nat;
 };
