   pricing: Pricing;
   problems: vec Problem;
   rail: Rail;
   status: OrderStatus;
   stripeSessionId: opt text;
   stripeSessionUrl: opt text;
   updatedAtNs: int;
 };
type Kind = 
 variant {
   unattributed: record {
                   claimedRef: text;
                   paymentRef: text;
                 };
