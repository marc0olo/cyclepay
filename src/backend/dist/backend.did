type ValidateError = 
 variant {
   aboveCeiling: record {
                   id: text;
                   maxUsdCents: nat;
                   usdCents: nat;
                 };
   belowFloor: record {
                 id: text;
                 minUsdCents: nat;
                 usdCents: nat;
               };
   duplicateTierId: text;
   emptyTierId;
   zeroUsdCents: text;
 };
type TransferIntent = 
 record {
   amountE8s: nat;
   createdAtTimeNs: nat64;
   memo: blob;
   to: Account;
 };
type Tier = 
 record {
   id: text;
   usdCents: nat;
 };
type Status__1 = 
 record {
   burnedInWindowE8s: nat;
   config: Config;
   heldOrders: nat;
   lastObservedFloat: opt FloatObservation;
   lowFloat: bool;
   paidOrders: nat;
 };
type Status = 
 record {
   generation: nat;
   isSet: bool;
   setAtNs: opt int;
 };
type SetError = variant {tooShort: record {
                                     min: nat;
                                     size: nat;
                                   };};
type Result_9 = 
 variant {
   err: CreateOrderError;
   ok: CreatedOrder;
 };
type Result_8 = 
 variant {
   err: ProcessOrderError;
   ok: Order;
 };
type Result_7 = 
 variant {
   err: ResolveError;
   ok: Entry;
 };
type Result_6 = 
 variant {
   err: ValidateError;
   ok;
 };
type Result_5 = 
 variant {
   err: ConfigError__2;
   ok;
 };
type Result_4 = 
 variant {
   err: ConfigError__1;
   ok;
 };
type Result_3 = 
 variant {
   err: IntervalError;
   ok;
 };
type Result_2 = 
 variant {
   err: OriginError;
   ok;
 };
type Result_11 = 
 variant {
   err: Reason;
   ok;
 };
type Result_10 = 
 variant {
   err: text;
   ok: Order;
 };
type Result_1 = 
 variant {
   err: ConfigError;
   ok;
 };
type Result = 
 variant {
   err: SetError;
   ok;
 };
type Response = 
 record {
   body: blob;
   headers: vec HeaderField;
   status_code: nat16;
   upgrade: opt bool;
 };
type ResolveError = 
 variant {
   alreadyResolved: nat;
   notFound: nat;
 };
type Request = 
 record {
   body: blob;
   headers: vec HeaderField;
   method: text;
   url: text;
 };
type Receipt = 
 record {
   cyclesMinted: opt nat;
   mintBlockIndex: opt nat;
   order: Order;
   paidUsdCents: opt nat;
   verification:
    record {
      netCents: opt nat;
      rateQueriedSources: nat;
      rateReceivedRates: nat;
      usdPerIcpMicros: nat;
      xdrPermyriadPerIcp: nat;
    };
 };
type Reason = 
 variant {
   amountAboveMax: record {
                     maxUsdCents: nat;
                     usdCents: nat;
                   };
   amountBelowMin: record {
                     minUsdCents: nat;
                     usdCents: nat;
                   };
   burnCapExhausted: record {
                       burnedE8s: nat;
                       capE8s: nat;
                     };
   canisterCyclesLow: record {
                        balance: nat;
                        min: nat;
                      };
   floatLow: record {
               observedE8s: opt nat;
               thresholdE8s: nat;
             };
   tooManyOpenOrders: record {
                        max: nat;
                        open: nat;
                      };
 };
type Rates = 
 record {
   fetchedAtNs: int;
   quality: Quality;
   usdPerIcpMicros: nat;
   xdrPermyriadPerIcp: nat;
 };
type Rail = variant {card;};
type QuotePreviews = 
 record {
   cyclesLedgerDepositFee: nat;
   quotes: vec QuotePreview;
   rates: opt Rates;
 };
type QuotePreview = 
 record {
   cycles: opt nat;
   feeCents: nat;
   netCents: opt nat;
   usdCents: nat;
 };
type Quality = 
 record {
   queriedSources: nat;
   receivedRates: nat;
   standardDeviation: nat;
 };
type ProcessOrderError = 
 variant {
   inFlight;
   notFound;
 };
type Pricing = 
 record {
   feeBps: nat;
   feeFixedCents: nat;
   rateQueriedSources: nat;
   rateReceivedRates: nat;
   rateStandardDeviation: nat;
   ratesFetchedAtNs: int;
   usdCents: nat;
   usdPerIcpMicros: nat;
   xdrPermyriadPerIcp: nat;
 };
type Page = 
 record {
   entries: vec Entry;
   nextCursor: opt nat;
 };
type Owner = variant {ii: principal;};
type OriginError = 
 variant {
   "empty";
   hasQueryOrFragment;
   notHttps;
 };
type OrderStatus = 
 variant {
   abandoned;
   awaitingTreasury;
   cancelled;
   created;
   delivered;
   expired;
   icpAtCmc;
   minting;
   needsReview;
   paid;
 };
type OrderId = text;
type Order = 
 record {
   createdAtNs: int;
   destination: Destination;
   expiredBy: opt ExpiredBy;
   expiresAtNs: opt int;
   id: OrderId;
   lockedCycles: nat;
   owner: Owner;
   paidUsdCents: opt nat;
   pricing: Pricing;
   rail: Rail;
   status: OrderStatus;
   stripeSessionId: opt text;
   stripeSessionUrl: opt text;
   updatedAtNs: int;
 };
type Kind = 
 variant {
   abandoned: record {
                orderId: OrderId;
                reason: text;
              };
   deliveryDelayed: record {
                      orderId: OrderId;
                      sinceNs: int;
                      stage: text;
                    };
   duplicate: record {
                orderId: OrderId;
                paymentRef: text;
              };
   refundAfterDelivery:
    record {
      cycles: nat;
      fullRefund: bool;
      orderId: OrderId;
      paymentRef: text;
      refundedCents: nat;
    };
   stuckMint: record {
                orderId: OrderId;
                stage: text;
              };
   unattributed: record {
                   claimedRef: text;
                   paymentRef: text;
                 };
   undeliverable: record {
                    cycles: nat;
                    orderId: OrderId;
                  };
   unprocessable: record {
                    eventId: text;
                    field: text;
                  };
 };
type JournalEntry = 
 record {
   blockIndex: opt nat;
   createdAtNs: int;
   cyclesMinted: opt nat;
   destination: Destination;
   orderId: OrderId;
   retries: nat;
   status: OrderStatus;
   transferIntent: opt TransferIntent;
   updatedAtNs: int;
 };
type IntervalError = 
 variant {
   intervalTooLong: record {maxNs: nat;};
   intervalTooShort: record {minNs: nat;};
   zeroInterval;
 };
type HttpRequestResult = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
