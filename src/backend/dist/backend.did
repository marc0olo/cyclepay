   amountAboveMax: nat;
   amountBelowMin: nat;
   canisterCyclesLow: nat;
   railClosed: nat;
   reserveShort: nat;
   stripeApiFailed: nat;
   tooManyOpenOrders: nat;
 };
type Receipt = 
 record {
   cyclesDelivered: opt nat;
   deliveryBlockIndex: opt nat;
   order: Order;
   paidUsdCents: opt nat;
   verification:
    record {
      netCents: opt nat;
      rateQueriedSources: nat;
      rateReceivedRates: nat;
      usdPerIcpMicros: nat;
      xdrPermyriadPerIcp: nat;
    };
 };
type Reason = 
 variant {
   amountAboveMax: record {
                     maxUsdCents: nat;
                     usdCents: nat;
                   };
   amountBelowMin: record {
                     minUsdCents: nat;
                     usdCents: nat;
                   };
