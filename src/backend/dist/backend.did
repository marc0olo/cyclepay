   zeroRateDelta;
   zeroRateSources;
 };
type ConfigError = 
 variant {
   alertNotBeforeMaxHold: record {
                            alertAfterNs: int;
                            maxHoldNs: int;
                          };
   nonPositiveAlertAfter;
   nonPositiveBurnWindow;
   nonPositiveMaxHold;
 };
type Config = 
 record {
   alertAfterNs: int;
   burnCapE8s: nat;
   burnWindowNs: int;
