type ValidateError = 
 variant {
   aboveCeiling: record {
                   id: text;
                   maxUsdCents: nat;
                   usdCents: nat;
                 };
   belowFloor: record {
                 id: text;
                 minUsdCents: nat;
                 usdCents: nat;
               };
   duplicateTierId: text;
   emptyTierId;
   zeroUsdCents: text;
 };
type TransferIntent = 
 record {
   amountE8s: nat;
   createdAtTimeNs: nat64;
   memo: blob;
   to: Account;
 };
type Tier = 
 record {
   id: text;
   usdCents: nat;
 };
type Status__1 = 
 record {
   burnedInWindowE8s: nat;
   config: Config;
   heldOrders: nat;
   lastObservedFloat: opt FloatObservation;
   lowFloat: bool;
   paidOrders: nat;
 };
type Status = 
 record {
   generation: nat;
   isSet: bool;
   setAtNs: opt int;
 };
type SetError = variant {tooShort: record {
                                     min: nat;
                                     size: nat;
                                   };};
type Result_9 = 
 variant {
   err: ProcessOrderError;
   ok: Order;
 };
type Result_8 = 
 variant {
   err: text;
   ok: Order;
 };
type Result_7 = 
 variant {
   err: ResolveError;
   ok: Entry;
 };
type Result_6 = 
 variant {
   err: ValidateError;
   ok;
 };
type Result_5 = 
 variant {
   err: ConfigError__2;
   ok;
 };
type Result_4 = 
 variant {
   err: ConfigError__1;
   ok;
 };
type Result_3 = 
 variant {
   err: IntervalError;
   ok;
 };
type Result_2 = 
 variant {
   err: OriginError;
   ok;
 };
type Result_11 = 
 variant {
   err: Reason;
   ok;
 };
type Result_10 = 
 variant {
   err: CreateOrderError;
   ok: CreatedOrder;
 };
type Result_1 = 
 variant {
   err: ConfigError;
   ok;
 };
type Result = 
 variant {
   err: SetError;
   ok;
 };
type Response = 
 record {
   body: blob;
   headers: vec HeaderField;
   status_code: nat16;
   upgrade: opt bool;
 };
type ResolveError = 
 variant {
   alreadyResolved: nat;
   notFound: nat;
 };
type Request = 
 record {
   body: blob;
   headers: vec HeaderField;
   method: text;
   url: text;
 };
type Receipt = 
 record {
   cyclesMinted: opt nat;
   deliveryBlockIndex: opt nat;
   order: Order;
   paidUsdCents: opt nat;
   verification:
    record {
      netCents: opt nat;
      rateQueriedSources: nat;
      rateReceivedRates: nat;
      usdPerIcpMicros: nat;
      xdrPermyriadPerIcp: nat;
    };
 };
type Reason = 
 variant {
   amountAboveMax: record {
                     maxUsdCents: nat;
                     usdCents: nat;
                   };
   amountBelowMin: record {
                     minUsdCents: nat;
                     usdCents: nat;
                   };
   canisterCyclesLow: record {
                        balance: nat;
                        min: nat;
                      };
   reserveShort: record {
                   available: nat;
                   requested: nat;
                 };
   tooManyOpenOrders: record {
                        max: nat;
                        open: nat;
                      };
 };
type Rates = 
 record {
   fetchedAtNs: int;
   quality: Quality;
   usdPerIcpMicros: nat;
   xdrPermyriadPerIcp: nat;
 };
type Rail = variant {card;};
type QuotePreviews = 
 record {
   quotes: vec QuotePreview;
   rates: opt Rates;
 };
type QuotePreview = 
 record {
   cycles: opt nat;
   feeCents: nat;
   netCents: opt nat;
   usdCents: nat;
 };
type Quality = 
 record {
   queriedSources: nat;
   receivedRates: nat;
   standardDeviation: nat;
 };
