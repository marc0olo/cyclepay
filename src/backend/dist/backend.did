 variant {
   anonymous;
   cancelledDuringCreation;
   destinationNotOwned;
   idGeneration;
   notAdmitted: Reason;
   quoteChanged: record {
                   minimum: nat;
                   quoted: nat;
                 };
   rateUnavailable;
   reserveUnavailable;
   sessionUnavailable: text;
   tierBelowFees: text;
   unknownTier: text;
 };
type Config__2 = 
 record {
   maxOpenOrdersPerPrincipal: nat;
   maxPurchaseUsdCents: nat;
   minCanisterCycles: nat;
   minPurchaseUsdCents: nat;
 };
type Config__1 = 
 record {
   feeBps: nat;
   feeFixedCents: nat;
   maxAgeNs: int;
   maxRateDeltaBps: nat;
   minRateSources: nat;
 };
