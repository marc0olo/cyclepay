type Withdrawn = 
 record {
   debited: nat;
   to: Account;
   withdrawn: nat;
 };
type WithdrawError = 
 variant {
   belowLedgerFee: record {
                     fee: nat;
                     floor: nat;
                   };
   nothingToWithdraw;
   ordersOutstanding: record {
                        holders: nat;
                        promised: nat;
                      };
   transferFailed: text;
 };
type ValidateError = 
 variant {
   aboveCeiling: record {
                   id: text;
                   maxUsdCents: nat;
                   usdCents: nat;
                 };
   belowFloor: record {
                 id: text;
                 minUsdCents: nat;
                 usdCents: nat;
               };
   duplicateTierId: text;
   emptyTierId;
   zeroUsdCents: text;
 };
type TransferIntent = 
 record {
   amountCycles: nat;
   createdAtTimeNs: nat64;
   memo: blob;
   to: Account;
 };
type Tier = 
 record {
   id: text;
   usdCents: nat;
 };
type Status = 
 record {
   generation: nat;
   isSet: bool;
   setAtNs: opt int;
 };
type SetError = variant {tooShort: record {
                                     min: nat;
                                     size: nat;
                                   };};
type Result_9 = 
 variant {
   err: ResolveProblemError;
   ok: nat;
 };
type Result_8 = 
 variant {
   err: ValidateError;
   ok;
 };
type Result_7 = 
 variant {
   err: ConfigError__2;
   ok;
 };
type Result_6 = 
 variant {
   err: LivemodeError;
   ok;
 };
type Result_5 = 
 variant {
   err: ConfigError__1;
   ok;
 };
type Result_4 = 
 variant {
   err: ConfigError;
   ok;
 };
type Result_3 = 
 variant {
   err: IntervalError;
   ok;
 };
type Result_2 = 
 variant {
   err: OriginError;
   ok;
 };
type Result_15 = 
 variant {
   err: Reason;
   ok;
 };
type Result_14 = 
 variant {
   err: CreateOrderError;
   ok: CreatedOrder;
 };
type Result_13 = 
 variant {
   err: ProcessOrderError;
   ok: Order;
 };
type Result_12 = 
 variant {
   err: text;
   ok: Order;
 };
type Result_11 = 
 variant {
   err: ListError;
   ok;
 };
type Result_10 = 
 variant {
   err: ResolveError;
   ok: Entry;
 };
type Result_1 = 
 variant {
   err: SetError;
   ok;
 };
type Result = 
 variant {
   err: WithdrawError;
   ok: Withdrawn;
 };
type Response = 
 record {
   body: blob;
   headers: vec HeaderField;
   status_code: nat16;
   upgrade: opt bool;
 };
type ResolveProblemError = 
 variant {
   ambiguous: record {
                candidates: vec text;
                tag: ProblemKindTag;
              };
   noSuchOrder: record {orderId: text;};
   noSuchProblem: record {tag: ProblemKindTag;};
   referenceNotFound: record {
                        reference: opt text;
                        tag: ProblemKindTag;
                      };
 };
type ResolveError = 
 variant {
   alreadyResolved: nat;
   notFound: nat;
 };
type Request = 
 record {
   body: blob;
   headers: vec HeaderField;
   method: text;
   url: text;
 };
type RefusalCounts = 
 record {
   amountAboveMax: nat;
   amountBelowMin: nat;
   buyerNotAllowed: nat;
   canisterCyclesLow: nat;
   railClosed: nat;
   reserveShort: nat;
   stripeApiFailed: nat;
   tooManyOpenOrders: nat;
   unboundedGiveaway: nat;
 };
type Receipt = 
 record {
   cyclesDelivered: opt nat;
   deliveryBlockIndex: opt nat;
   order: Order;
   paidUsdCents: opt nat;
   verification:
    record {
      netCents: opt nat;
      rateQueriedSources: nat;
      rateReceivedRates: nat;
      usdPerIcpMicros: nat;
      xdrPermyriadPerIcp: nat;
    };
 };
type Reason = 
 variant {
   amountAboveMax: record {
                     maxUsdCents: nat;
                     usdCents: nat;
                   };
   amountBelowMin: record {
                     minUsdCents: nat;
                     usdCents: nat;
                   };
   buyerNotAllowed;
   canisterCyclesLow: record {
                        balance: nat;
                        min: nat;
                      };
   reserveShort: record {
                   available: nat;
                   requested: nat;
                 };
   tooManyOpenOrders: record {
                        max: nat;
                        open: nat;
                      };
   unboundedGiveaway: record {reserveFloor: nat;};
 };
type Rates = 
 record {
   fetchedAtNs: int;
   quality: Quality;
   usdPerIcpMicros: nat;
   xdrPermyriadPerIcp: nat;
 };
type RailStateLatch = 
 record {
   canisterCyclesLow: bool;
   railClosed: bool;
   reserveShort: bool;
   stripeApiFailing: bool;
   unboundedGiveaway: bool;
 };
type Rail = variant {card;};
type QuotePreviews = 
 record {
   quotes: vec QuotePreview;
   rates: opt Rates;
 };
type QuotePreview = 
 record {
   cycles: opt nat;
   feeCents: nat;
   netCents: opt nat;
   usdCents: nat;
 };
type Quality = 
 record {
   queriedSources: nat;
   receivedRates: nat;
   standardDeviation: nat;
 };
type ProcessOrderError = 
 variant {
   inFlight;
   notFound;
 };
type ProblemKindTag = 
 variant {
   deliveryStuck;
   duplicate;
   paidNotCredited;
   refundAfterDelivery;
 };
type ProblemKind = 
 variant {
   deliveryStuck: record {stage: text;};
   duplicate: record {paymentRef: text;};
   paidNotCredited: record {
                      paymentRef: text;
                      sessionId: text;
                    };
   refundAfterDelivery:
    record {
      cycles: nat;
      fullRefund: bool;
      paymentRef: text;
      refundedCents: nat;
    };
 };
type Problem = 
 record {
   detail: text;
   filedAtNs: int;
   kind: ProblemKind;
   resolvedAtNs: opt int;
 };
type Pricing = 
 record {
   feeBps: nat;
   feeFixedCents: nat;
   rateQueriedSources: nat;
   rateReceivedRates: nat;
   rateStandardDeviation: nat;
   ratesFetchedAtNs: int;
   usdCents: nat;
   usdPerIcpMicros: nat;
   xdrPermyriadPerIcp: nat;
 };
type Page__2 = 
 record {
   events: vec Event;
   nextCursor: opt nat;
 };
type Page__1 = 
 record {
   nextCursor: opt OrderId;
   orders: vec Order;
 };
type Page = 
 record {
   entries: vec Entry;
   nextCursor: opt nat;
 };
type Owner = variant {ii: principal;};
type OriginError = 
 variant {
   "empty";
   hasQueryOrFragment;
   notHttps;
 };
type OrderStatus = 
 variant {
   abandoned;
   cancelled;
   created;
   delivered;
   expired;
   needsReview;
   paid;
 };
type OrderId = text;
type Order = 
 record {
   abandonedReason: opt text;
   createdAtNs: int;
   delayedAtNs: opt int;
   destination: Destination;
   expiredBy: opt ExpiredBy;
   expiresAtNs: opt int;
   id: OrderId;
   lockedCycles: nat;
   owner: Owner;
   paidUsdCents: opt nat;
   pricing: Pricing;
   problems: vec Problem;
   rail: Rail;
   status: OrderStatus;
   stripeSessionId: opt text;
   stripeSessionUrl: opt text;
   updatedAtNs: int;
 };
type LivemodeError = variant {simulationDivisorSet: record {divisor: nat;};};
type ListError = 
 variant {
   alreadyPresent: record {"principal": principal;};
   anonymousNotAllowed;
   notPresent: record {"principal": principal;};
 };
type Kind = 
 variant {
   unattributed: record {
                   claimedRef: text;
                   paymentRef: text;
                 };
   unprocessable: record {
                    eventId: text;
                    field: text;
                  };
 };
type JournalEntry = 
 record {
   blockIndex: opt nat;
   createdAtNs: int;
   cyclesDelivered: opt nat;
   destination: Destination;
   lastError: opt text;
   orderId: OrderId;
   retries: nat;
   status: OrderStatus;
   transferIntent: opt TransferIntent;
   updatedAtNs: int;
 };
type IntervalError = 
 variant {
   intervalTooLong: record {maxNs: nat;};
   zeroInterval;
 };
type HttpRequestResult = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type HeaderField = 
 record {
   text;
   text;
 };
type Filter = 
 record {
   createdFromNs: opt int;
   createdToNs: opt int;
   owner: opt principal;
   status: opt OrderStatus;
   withUnresolvedProblems: bool;
 };
type ExpiredBy = 
 variant {
   sessionExpired;
   sessionFailed;
 };
type Event = 
 record {
   atNs: int;
   detail: text;
   seq: nat;
   tag: text;
 };
type Entry = 
 record {
   createdAtNs: int;
   detail: text;
   id: nat;
   kind: Kind;
   rail: Rail;
   resolvedAtNs: opt int;
 };
type Drift = 
 record {
   is: nat;
   status: text;
   was: nat;
 };
type Destination = variant {cyclesLedgerAccount: Account;};
type DelayedDelivery = 
 record {
   delayedAtNs: opt int;
   heldSinceNs: int;
   orderId: OrderId;
   pastMaxHold: bool;
   retries: nat;
   status: OrderStatus;
   waitedNs: int;
 };
type CreatedOrder = record {order: Order;};
type CreateOrderError = 
 variant {
   anonymous;
   cancelledDuringCreation;
   destinationNotOwned;
   idGeneration;
   notAdmitted: Reason;
   quoteChanged: record {
                   minimum: nat;
                   quoted: nat;
                 };
   rateUnavailable;
   reserveUnavailable;
   sessionUnavailable: text;
   simulationScaleTooSmall: record {
                              ledgerFee: nat;
                              scaledCycles: nat;
                            };
   tierBelowFees: text;
   unknownTier: text;
 };
type Config__2 = 
 record {
   alertAfterNs: int;
   maxHoldNs: int;
 };
type Config__1 = 
 record {
   maxOpenOrdersPerPrincipal: nat;
   maxPurchaseUsdCents: nat;
   minCanisterCycles: nat;
   minPurchaseUsdCents: nat;
 };
type ConfigError__2 = 
 variant {
   alertNotBeforeMaxHold: record {
                            alertAfterNs: int;
                            maxHoldNs: int;
                          };
   nonPositiveAlertAfter;
   nonPositiveMaxHold;
 };
type ConfigError__1 = 
 variant {
   floorAboveCeiling: record {
                        maxUsdCents: nat;
                        minUsdCents: nat;
                      };
   floorUndeliverableAtDivisor:
    record {
      divisor: nat;
      ledgerFee: nat;
      minUsdCents: nat;
      scaledCycles: nat;
    };
   tierAboveCeiling: record {
                       maxUsdCents: nat;
                       tierId: text;
                       usdCents: nat;
                     };
   tierBelowFloor: record {
                     minUsdCents: nat;
                     tierId: text;
                     usdCents: nat;
                   };
   zeroOpenOrderCap;
   zeroPurchaseCeiling;
 };
type ConfigError = 
 variant {
   divisorChangeWithOrders: record {stored: nat;};
   divisorNeedsSandbox: record {expectLivemode: opt bool;};
   divisorUndeliverable: record {
                           ledgerFee: nat;
                           scaledCycles: nat;
                         };
   feeBpsTooHigh;
   maxAgeTooLong: record {
                    allowedNs: int;
                    maxAgeNs: int;
                  };
   nonPositiveMaxAge;
   zeroDivisor;
   zeroRateDelta;
   zeroRateSources;
 };
type Config = 
 record {
   divisor: nat;
   feeBps: nat;
   feeFixedCents: nat;
   maxAgeNs: int;
   maxRateDeltaBps: nat;
   minRateSources: nat;
 };
type Amount = 
 variant {
   custom: nat;
   tier: text;
 };
type Account = 
 record {
   owner: principal;
   subaccount: opt blob;
 };
/// Fully on-chain cycles gateway — composition root.
/// 
/// The module layout this actor composes: Orders.mo, Delivery.mo, Pricing.mo,
/// Reserve.mo, Gate.mo, Problems.mo, Orphans.mo, Auth.mo, Card.mo, Http.mo.
/// Decision record for the `§N` comments: `docs/DESIGN.md`.
service : {
  abandon_order: (id: OrderId, reason: text) -> (Result_12);
  add_admin: (p: principal) -> (Result_11);
  add_allowed_buyer: (p: principal) -> (Result_11);
  admin_order: (id: OrderId) -> (opt Order);
  admin_orders: (filter: Filter, afterId: opt OrderId, limit: nat) ->
   (Page__1) query;
  admin_receipt: (id: OrderId) -> (opt Receipt);
  admin_status: () ->
   (record {
      caller: principal;
      granted: bool;
      isController: bool;
    }) query;
  admins: () -> (vec principal) query;
  allowed_buyers: () -> (vec principal) query;
  audit_log: (afterSeq: opt nat, limit: nat) -> (Page__2) query;
  can_purchase: (usdCents: nat) -> (Result_15) query;
  cancel_order: (id: OrderId) -> (Result_12);
  card_tiers: () -> (vec Tier) query;
  create_order: (amount: Amount, destination: Destination, minCycles:
   opt nat) -> (Result_14);
  cycles_status: () -> (record {
                          balance: nat;
                          floor: nat;
                        }) query;
  delayed_deliveries: (afterId: opt OrderId, limit: nat) ->
   (record {
      entries: vec DelayedDelivery;
      nextCursor: opt OrderId;
    }) query;
  delivery_journal: (id: OrderId) -> (opt JournalEntry) query;
  delivery_stats: () ->
   (record {
      availableToSell: nat;
      deliveredCycles: nat;
      deliveredOrders: nat;
      deliveredUsdCents: nat;
      nullPaid: nat;
      refusingNow: RailStateLatch;
    }) query;
  expected_livemode: () -> (opt bool) query;
  expire_order: (id: OrderId) -> (Result_12);
  get_order: (id: OrderId) -> (opt Order) query;
  health: () -> (bool) query;
  http_request: (req: Request) -> (Response) query;
  http_request_update: (req: Request) -> (Response);
  lifecycle_config: () ->
   (record {
      delivery: Config__2;
      gate: Config__1;
    }) query;
  list_orders: (afterId: opt OrderId, limit: nat) -> (Page__1) query;
  operator_summary: () ->
   (record {
      availableToSell: nat;
      deliveriesDelayed: nat;
      deliveriesOutstanding: nat;
      ordersNeedingReview: nat;
      ordersWithProblems: nat;
      orphansUnresolved: nat;
      problemsUnresolved: nat;
      refusingNow: RailStateLatch;
      reserveObservedAtNs: opt int;
    }) query;
  order_for_payment: (paymentRef: text) -> (opt OrderId) query;
  orphan_depth: () -> (record {
                         retained: nat;
                         unresolved: nat;
                       }) query;
  orphans: (afterId: opt nat, limit: nat) -> (Page) query;
  orphans_unresolved: (afterId: opt nat, limit: nat) -> (Page) query;
  pending_deliveries: () -> (vec JournalEntry) query;
  pricing_status: () ->
   (record {
      config: Config;
      lastAttempt: opt record {
                         atNs: int;
                         detail: text;
                         ok: bool;
                       };
      rates: opt Rates;
      xrcCanisterId: opt text;
    }) query;
  problem_depth: () -> (record {
                          orders: nat;
                          unresolved: nat;
                        }) query;
  process_order: (id: OrderId) -> (Result_13);
  quote_previews: (amounts: vec nat) -> (QuotePreviews) query;
  receipt: (id: OrderId) -> (opt Receipt) query;
  record_delivered: (id: OrderId, blockIndex: nat) -> (Result_12);
  recount_orders: () -> (vec record {
                               text;
                               nat;
                             });
  recovery_status: () ->
   (record {
      indexScan:
       record {
         chunkSize: nat;
         expectedFullCycleNs: nat;
         inFlightCycle:
          record {
            ordersRead: nat;
            repairs: nat;
            startedAtNs: int;
          };
         lastCompletedCycle:
          opt
           record {
             completedAtNs: int;
             ordersRead: nat;
             repairs: nat;
             startedAtNs: int;
           };
         storedOrders: nat;
       };
      intervalNs: nat;
      lastCountReconcile:
       opt
        record {
          atNs: int;
          drift: vec Drift;
          ordersRead: nat;
          refused: vec Drift;
        };
      lastCountReconcileAttemptNs: int;
      lastReserveReconcileAttemptNs: int;
      lastSweep: opt record {
                       atNs: int;
                       pending: nat;
                     };
      sweepInFlight: bool;
    }) query;
  refresh_rates: () -> (opt Rates);
  refresh_reserve: () -> (nat);
  refusal_counts: () ->
   (record {
      counts: RefusalCounts;
      refusingNow: RailStateLatch;
    }) query;
  remove_admin: (p: principal) -> (Result_11);
  remove_allowed_buyer: (p: principal) -> (Result_11);
  reserve_status: () ->
   (record {
      availableToSell: nat;
      canisterCycles: nat;
      cyclesLedgerFee: nat;
      expiredOrders: nat;
      minCanisterCycles: nat;
      openOrders: nat;
      paidIntentsIndexed: nat;
      promiseHolders: nat;
      promisedTotal: nat;
      reserveAccount: Account;
      reserveFloor: nat;
      reserveObservedAtNs: opt int;
      tallySaturations: nat;
      totalOrders: nat;
    }) query;
  resolve_orphan: (id: nat) -> (Result_10);
  resolve_problem: (orderId: OrderId, tag: ProblemKindTag, paymentRef:
   opt text) -> (Result_9);
  set_card_tiers: (tiers: vec Tier) -> (Result_8);
  set_delivery_config: (config: Config__2) -> (Result_7);
  set_expected_livemode: (expected: opt bool) -> (Result_6);
  set_gate_config: (config: Config__1) -> (Result_5);
  set_pricing_config: (config: Config) -> (Result_4);
  set_recovery_interval: (intervalNs: nat) -> (Result_3);
  set_stripe_api_key: (key: text) -> (Result_1);
  set_stripe_origin: (origin: text) -> (Result_2);
  set_webhook_secret: (secret: text) -> (Result_1);
  stripe_api_key_status: () -> (Status) query;
  stripe_origin: () -> (opt text) query;
  transform_stripe_response: (args:
   record {
     context: blob;
     response: HttpRequestResult;
   }) -> (HttpRequestResult) query;
  webhook_secret_status: () -> (Status) query;
  withdraw_reserve: () -> (Result);
}
