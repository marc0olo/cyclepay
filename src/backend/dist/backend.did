 };
type ConfigError__1 = 
 variant {
   floorAboveCeiling: record {
                        maxUsdCents: nat;
                        minUsdCents: nat;
                      };
   tierAboveCeiling: record {
                       maxUsdCents: nat;
                       tierId: text;
                       usdCents: nat;
                     };
   tierBelowFloor: record {
                     minUsdCents: nat;
                     tierId: text;
