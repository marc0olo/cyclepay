   err: ConfigError__2;
   ok;
 };
type Result_4 = 
 variant {
   err: ConfigError__1;
   ok;
 };
type Result_3 = 
 variant {
   err: ConfigError;
   ok;
 };
type Result_2 = 
 variant {
   err: IntervalError;
   ok;
 };
type Result_12 = 
 variant {
   err: Reason;
   ok;
 };
type Result_11 = 
 variant {
   err: CreateOrderError;
   ok: CreatedOrder;
 };
type Result_10 = 
 variant {
   err: ProcessOrderError;
   ok: Order;
 };
